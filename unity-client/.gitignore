# Unity gitignore
# https://github.com/github/gitignore/blob/main/Unity.gitignore

/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Mm]emoryCaptures/
/[Aa]rtifacts/

# Asset meta data should only be ignored when the corresponding asset folder is ignored
/[Aa]ssets/AssetStoreTools*.asset
![Aa]ssets/AssetStoreTools
![Aa]ssets/AssetStoreTools/*.asset
![Aa]ssets/AssetStoreTools/*

# Autogenerated serialization of Project settings
/[Pp]rojectSettings/[Au]toStreamingScene.asset

# Unity3D generated
UnityLibrary.yml
*.pidb
*.symdb

# Crashlytics generated
crashlytics-build.properties

# Keystore for android builds
*.keystore

# If you switch between 2D and 3D, this will be auto generated and shouldn't be tracked
/[Aa]ssets/UnityStockReflectionIndicator

# Build preferences
/[Pp]rojectSettings/[Bb]uildProfileSettings.asset

# Crashlytics generated
crashlytics-build.properties

# Autogenerated from a memory debugging session, see "Window" -> "QR Code"
*.pidb

# Unity3D generated meta on asset changes
*.meta

# Autogenerated Build Settings
/[Pp]rojectSettings/[Ss]ceneTemplateSettings.asset

# Unity shader cache
/[Ll]ibrary/ShaderCache/

# Unity project settings
/[Pp]rojectSettings/[Pp]ackageManager

# Unity generated
/[Pp]ackages/

# Memory captures
*.memoryprofiler

# Temp files
*.tmp
*.temp

# OS generated
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vs/
.vscode/
*.suo
*.user
*.userprefs
*.sln
*.sln.docstates
*.csproj
*.unityproj
*.cproj
*.slnx
*.slnx.sqlite

# Build output
*.exe
*.dll
*.so
*.dylib
*.app

# Build folders
Build/
Builds/
Temp/
Obj/
Library/
