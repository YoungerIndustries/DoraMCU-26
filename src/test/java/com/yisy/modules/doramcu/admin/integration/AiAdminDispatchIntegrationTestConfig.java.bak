package com.yisy.modules.doramcu.admin.integration;

import com.fasterxml.jackson.databind.ObjectMapper;
import com.yisy.modules.doramcu.admin.model.AiAdminTestCase;
import com.yisy.modules.doramcu.admin.model.AiAdminTestCase.TestStatus;
import com.yisy.modules.doramcu.admin.model.TestDefinition;
import com.yisy.modules.doramcu.ai.client.AiRestClient;
import com.yisy.modules.doramcu.admin.service.*;
import com.yisy.modules.doramcu.admin.repository.AiAdminNotificationRepository;
import com.yisy.modules.doramcu.admin.repository.AiAdminOrderRepository;
import com.yisy.modules.doramcu.controller.misc.OrderProgressWebSocketHandler;
import com.yisy.modules.doramcu.controller.misc.PresenceWebSocketHandler;
import com.yisy.modules.doramcu.admin.repository.AiAdminTestCaseRepository;
import com.yisy.modules.doramcu.admin.repository.AiAdminTestReportRepository;
import com.yisy.modules.doramcu.model.galaxy.Galaxy;
import com.yisy.modules.doramcu.repository.ai.AiCharacterRepository;
import com.yisy.modules.doramcu.repository.galaxy.GalaxyRepository;
import org.mockito.Mockito;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.ComponentScan;
import org.springframework.context.annotation.Configuration;
import org.springframework.context.annotation.FilterType;
import org.springframework.context.annotation.PropertySource;
import org.springframework.data.jpa.repository.config.EnableJpaRepositories;
import org.springframework.jdbc.datasource.embedded.EmbeddedDatabaseBuilder;
import org.springframework.jdbc.datasource.embedded.EmbeddedDatabaseType;
import org.springframework.orm.jpa.JpaTransactionManager;
import org.springframework.orm.jpa.JpaVendorAdapter;
import org.springframework.orm.jpa.LocalContainerEntityManagerFactoryBean;
import org.springframework.orm.jpa.vendor.HibernateJpaVendorAdapter;
import org.springframework.transaction.PlatformTransactionManager;
import org.springframework.transaction.annotation.EnableTransactionManagement;

import javax.sql.DataSource;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;
import java.util.Optional;

/**
 * Minimal Spring test configuration for AI admin dispatch integration tests.
 * <p>
 * Uses an H2 in-memory database with create-drop DDL auto, so each test
 * runs against a fresh schema. Real JPA repositories are wired against H2,
 * while external dependencies (TestExecutor, TestRegistry, GalaxyRepository)
 * are mocked to return deterministic results.
 * </p>
 */
@Configuration
@PropertySource("classpath:application-test.properties")
@EnableJpaRepositories(
        basePackages = {"com.yisy.modules.doramcu.repository", "com.yisy.modules.doramcu.admin.repository"},
        includeFilters = @ComponentScan.Filter(
                type = FilterType.ASSIGNABLE_TYPE,
                classes = {
                        AiAdminOrderRepository.class,
                        AiCharacterRepository.class,
                        AiAdminNotificationRepository.class,
                        AiAdminTestReportRepository.class,
                        AiAdminTestCaseRepository.class
                }
        )
)
@EnableTransactionManagement
@ComponentScan(
        basePackages = {"com.yisy.modules.doramcu.admin.service"},
        includeFilters = @ComponentScan.Filter(
                type = FilterType.ASSIGNABLE_TYPE,
                classes = {
                        AiAdminService.class,
                        AiAdminDispatchService.class,
                        AiAdminNotificationService.class,
                        AiAdminLlmService.class,
                        TestReportGenerator.class
                }
        ),
        useDefaultFilters = false
)
public class AiAdminDispatchIntegrationTestConfig {

    @Bean
    public DataSource dataSource() {
        return new EmbeddedDatabaseBuilder()
                .setType(EmbeddedDatabaseType.H2)
                .setName("ai_admin_dispatch_testdb")
                .build();
    }

    @Bean
    public LocalContainerEntityManagerFactoryBean entityManagerFactory(DataSource dataSource) {
        LocalContainerEntityManagerFactoryBean em = new LocalContainerEntityManagerFactoryBean();
        em.setDataSource(dataSource);
        em.setPackagesToScan(
                "com.yisy.modules.doramcu.admin.model",
                "com.yisy.modules.doramcu.eve.model",
                "com.yisy.modules.doramcu.model"
        );

        JpaVendorAdapter vendorAdapter = new HibernateJpaVendorAdapter();
        em.setJpaVendorAdapter(vendorAdapter);

        Map<String, Object> properties = new HashMap<>();
        properties.put("hibernate.hbm2ddl.auto", "create-drop");
        properties.put("hibernate.dialect", "org.hibernate.dialect.H2Dialect");
        properties.put("hibernate.show_sql", "false");
        properties.put("jakarta.persistence.sharedCache.mode", "DISABLE_SELECTIVE");
        em.setJpaPropertyMap(properties);

        return em;
    }

    @Bean
    public PlatformTransactionManager transactionManager(LocalContainerEntityManagerFactoryBean entityManagerFactory) {
        JpaTransactionManager transactionManager = new JpaTransactionManager();
        transactionManager.setEntityManagerFactory(entityManagerFactory.getObject());
        return transactionManager;
    }

    @Bean
    public ObjectMapper objectMapper() {
        return new ObjectMapper();
    }

    @Bean
    public GalaxyRepository galaxyRepository() {
        GalaxyRepository mock = Mockito.mock(GalaxyRepository.class);
        Galaxy galaxy = new Galaxy();
        galaxy.setId(1L);
        galaxy.setName("Alpha Centauri");
        galaxy.setGalaxyOverseerId(100L);
        Mockito.when(mock.findByName("Alpha Centauri")).thenReturn(Optional.of(galaxy));
        return mock;
    }

    @Bean
    public TestRegistry testRegistry() {
        TestRegistry mock = Mockito.mock(TestRegistry.class);
        List<TestDefinition> catalog = new ArrayList<>();

        TestDefinition apiTest = new TestDefinition("api-001", "API Health Check", "API", "Check API health");
        TestDefinition gameTest = new TestDefinition("game-001", "Galaxy Travel", "GAME", "Test galaxy travel");
        TestDefinition chatTest = new TestDefinition("chat-001", "AI Chat Response", "AI_CHAT", "Test AI chat");
        TestDefinition authTest = new TestDefinition("auth-001", "Admin Login", "AUTH", "Test admin login");

        catalog.add(apiTest);
        catalog.add(gameTest);
        catalog.add(chatTest);
        catalog.add(authTest);

        Mockito.when(mock.getTestCatalog()).thenReturn(catalog);
        Mockito.when(mock.getTestsByCategory("API")).thenReturn(List.of(apiTest));
        Mockito.when(mock.getTestsByCategory("GAME")).thenReturn(List.of(gameTest));
        Mockito.when(mock.getTestsByCategory("AI_CHAT")).thenReturn(List.of(chatTest));
        Mockito.when(mock.getTestsByCategory("AUTH")).thenReturn(List.of(authTest));
        Mockito.when(mock.getTestById("api-001")).thenReturn(apiTest);
        Mockito.when(mock.getTestById("game-001")).thenReturn(gameTest);
        Mockito.when(mock.getTestById("chat-001")).thenReturn(chatTest);
        Mockito.when(mock.getTestById("auth-001")).thenReturn(authTest);
        Mockito.when(mock.executeTest(Mockito.anyString())).thenReturn(true);

        return mock;
    }

    @Bean
    public TestExecutor testExecutor(TestRegistry testRegistry) {
        TestExecutor mock = Mockito.mock(TestExecutor.class);

        AiAdminTestCase apiTest = new AiAdminTestCase(null, "API Health Check", "API");
        apiTest.setStatus(TestStatus.PASSED);
        apiTest.setDurationMs(100);

        AiAdminTestCase gameTest = new AiAdminTestCase(null, "Galaxy Travel", "GAME");
        gameTest.setStatus(TestStatus.PASSED);
        gameTest.setDurationMs(200);

        AiAdminTestCase chatTest = new AiAdminTestCase(null, "AI Chat Response", "AI_CHAT");
        chatTest.setStatus(TestStatus.PASSED);
        chatTest.setDurationMs(150);

        AiAdminTestCase authTest = new AiAdminTestCase(null, "Admin Login", "AUTH");
        authTest.setStatus(TestStatus.PASSED);
        authTest.setDurationMs(50);

        List<AiAdminTestCase> allTests = List.of(apiTest, gameTest, chatTest, authTest);

        Mockito.when(mock.runAllTests()).thenReturn(allTests);
        Mockito.when(mock.runTestsByCategory("API")).thenReturn(List.of(apiTest));
        Mockito.when(mock.runTestsByCategory("GAME")).thenReturn(List.of(gameTest));
        Mockito.when(mock.runTestsByCategory("AI_CHAT")).thenReturn(List.of(chatTest));
        Mockito.when(mock.runTestsByCategory("AUTH")).thenReturn(List.of(authTest));

        return mock;
    }

    @Bean
    public AiAdminNotificationService aiAdminNotificationService(AiAdminNotificationRepository notificationRepository) {
        return new AiAdminNotificationService(notificationRepository);
    }

    @Bean
    public TestReportGenerator testReportGenerator(AiAdminTestReportRepository reportRepository,
                                                    AiAdminTestCaseRepository testCaseRepository,
                                                    ObjectMapper objectMapper) {
        return new TestReportGenerator(reportRepository, testCaseRepository, objectMapper);
    }

    @Bean
    public AiAdminService aiAdminService(AiAdminOrderRepository orderRepository,
                                          AiAdminTestReportRepository reportRepository,
                                          TestExecutor testExecutor,
                                          TestReportGenerator testReportGenerator) {
        return new AiAdminService(orderRepository, reportRepository, testExecutor, testReportGenerator);
    }

    @Bean
    public AiRestClient aiRestClient() {
        AiRestClient mock = Mockito.mock(AiRestClient.class);
        Mockito.when(mock.chat(Mockito.anyString(), Mockito.anyString(), Mockito.isNull()))
                .thenReturn("{\"action\":\"INVESTIGATE\",\"reasoning\":\"LLM analysis complete\",\"parameters\":{}}");
        return mock;
    }

    @Bean
    public AiAdminLlmService aiAdminLlmService(AiRestClient aiRestClient, ObjectMapper objectMapper) {
        return new AiAdminLlmService(aiRestClient, objectMapper);
    }

    @Bean
    public OrderProgressWebSocketHandler orderProgressWebSocketHandler() {
        return Mockito.mock(OrderProgressWebSocketHandler.class);
    }

    @Bean
    public AiAdminOrderProgressService aiAdminOrderProgressService(AiAdminOrderRepository orderRepository,
                                                                    OrderProgressWebSocketHandler orderProgressWebSocketHandler) {
        return new AiAdminOrderProgressService(orderRepository, orderProgressWebSocketHandler);
    }

    @Bean
    public AiAdminProductionService aiAdminProductionService() {
        return Mockito.mock(AiAdminProductionService.class);
    }

    @Bean
    public PresenceWebSocketHandler presenceWebSocketHandler() {
        return Mockito.mock(PresenceWebSocketHandler.class);
    }

    @Bean
    public AiAdminDispatchService aiAdminDispatchService(AiAdminOrderRepository orderRepository,
                                                          AiCharacterRepository aiCharacterRepository,
                                                          GalaxyRepository galaxyRepository,
                                                          TestExecutor testExecutor,
                                                          TestRegistry testRegistry,
                                                          TestReportGenerator testReportGenerator,
                                                          AiAdminNotificationService notificationService,
                                                          AiAdminLlmService llmService,
                                                          AiAdminOrderProgressService progressService,
                                                          AiAdminProductionService productionService,
                                                          PresenceWebSocketHandler presenceWebSocketHandler) {
        AiAdminScheduleService scheduleService = Mockito.mock(AiAdminScheduleService.class);
        return new AiAdminDispatchService(orderRepository, aiCharacterRepository, galaxyRepository,
                testExecutor, testRegistry, testReportGenerator, notificationService, llmService,
                progressService, productionService, presenceWebSocketHandler, scheduleService);
    }
}
