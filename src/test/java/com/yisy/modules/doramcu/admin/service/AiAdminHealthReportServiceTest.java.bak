package com.yisy.modules.doramcu.admin.service;

import com.yisy.modules.doramcu.admin.model.AiAdminHealthReport;
import com.yisy.modules.doramcu.admin.model.AiAdminIncident;
import com.yisy.modules.doramcu.admin.model.AiAdminOrder;
import com.yisy.modules.doramcu.admin.repository.AiAdminHealthReportRepository;
import com.yisy.modules.doramcu.admin.repository.AiAdminIncidentRepository;
import com.yisy.modules.doramcu.admin.repository.AiAdminOrderRepository;
import com.yisy.modules.doramcu.admin.service.AiAdminLlmService.LlmAnalysisResult;
import com.yisy.modules.doramcu.eve.model.AiCharacter;
import com.yisy.modules.doramcu.repository.ai.AiCharacterRepository;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;

import java.time.LocalDateTime;
import java.util.ArrayList;
import java.util.List;
import java.util.Optional;

import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.ArgumentMatchers.*;
import static org.mockito.Mockito.*;

@ExtendWith(MockitoExtension.class)
class AiAdminHealthReportServiceTest {

    @Mock
    private AiAdminHealthReportRepository reportRepository;

    @Mock
    private AiAdminOrderRepository orderRepository;

    @Mock
    private AiAdminIncidentRepository incidentRepository;

    @Mock
    private AiCharacterRepository characterRepository;

    @Mock
    private AiAdminLlmService llmService;

    private AiAdminHealthReportService service;

    private AiCharacter admin;

    @BeforeEach
    void setUp() {
        service = new AiAdminHealthReportService(
                reportRepository, orderRepository, incidentRepository,
                characterRepository, llmService);

        admin = new AiCharacter();
        admin.setId(1L);
        admin.setName("TestAdmin");
        admin.setRole("Galaxy Overseer");
        admin.setEmpireName("TestEmpire");
        admin.setTotalExperience(100);
        admin.setLeadershipRating(8);
    }

    @Test
    void generateReport_createsReportWithOrderData() {
        when(characterRepository.findById(1L)).thenReturn(Optional.of(admin));
        List<AiAdminOrder> orders = new ArrayList<>();
        AiAdminOrder order = new AiAdminOrder();
        order.setStatus(AiAdminOrder.OrderStatus.COMPLETED);
        orders.add(order);
        when(orderRepository.findByAssignedAiAdminIdAndCreatedAtBetween(anyLong(), any(), any()))
                .thenReturn(orders);
        when(incidentRepository.findByAssignedAiAdminIdAndCreatedAtBetween(anyLong(), any(), any()))
                .thenReturn(new ArrayList<>());
        when(incidentRepository.countByAssignedAiAdminIdAndStatusIn(anyLong(), anyList()))
                .thenReturn(0L);
        when(llmService.analyzeReport(any(), any())).thenReturn(
                new LlmAnalysisResult("REVIEW", "Good performance", new java.util.HashMap<>(),
                        "Good performance", true, null));
        when(reportRepository.save(any(AiAdminHealthReport.class))).thenAnswer(i -> i.getArgument(0));

        AiAdminHealthReport report = service.generateReport(1L, AiAdminHealthReport.ReportType.DAILY);

        assertNotNull(report);
        assertEquals(1L, report.getAiAdminId());
        assertEquals(AiAdminHealthReport.ReportType.DAILY, report.getReportType());
        assertEquals(1, report.getOrdersProcessed());
        assertEquals(1, report.getOrdersCompleted());
        assertEquals(0, report.getOrdersFailed());
        assertEquals("Good performance", report.getRecommendations());
    }

    @Test
    void generateReport_countsFailedOrders() {
        when(characterRepository.findById(1L)).thenReturn(Optional.of(admin));
        List<AiAdminOrder> orders = new ArrayList<>();
        AiAdminOrder order = new AiAdminOrder();
        order.setStatus(AiAdminOrder.OrderStatus.FAILED);
        orders.add(order);
        when(orderRepository.findByAssignedAiAdminIdAndCreatedAtBetween(anyLong(), any(), any()))
                .thenReturn(orders);
        when(incidentRepository.findByAssignedAiAdminIdAndCreatedAtBetween(anyLong(), any(), any()))
                .thenReturn(new ArrayList<>());
        when(incidentRepository.countByAssignedAiAdminIdAndStatusIn(anyLong(), anyList()))
                .thenReturn(0L);
        when(llmService.analyzeReport(any(), any())).thenReturn(
                new LlmAnalysisResult("REVIEW", "Improve failure rate", new java.util.HashMap<>(),
                        "Improve failure rate", true, null));
        when(reportRepository.save(any(AiAdminHealthReport.class))).thenAnswer(i -> i.getArgument(0));

        AiAdminHealthReport report = service.generateReport(1L, AiAdminHealthReport.ReportType.DAILY);

        assertEquals(1, report.getOrdersFailed());
        assertEquals(0, report.getOrdersCompleted());
    }

    @Test
    void generateReport_countsIncidents() {
        when(characterRepository.findById(1L)).thenReturn(Optional.of(admin));
        when(orderRepository.findByAssignedAiAdminIdAndCreatedAtBetween(anyLong(), any(), any()))
                .thenReturn(new ArrayList<>());
        List<AiAdminIncident> incidents = new ArrayList<>();
        incidents.add(new AiAdminIncident());
        when(incidentRepository.findByAssignedAiAdminIdAndCreatedAtBetween(anyLong(), any(), any()))
                .thenReturn(incidents);
        when(incidentRepository.countByAssignedAiAdminIdAndStatusIn(anyLong(), anyList()))
                .thenReturn(2L);
        when(llmService.analyzeReport(any(), any())).thenReturn(
                new LlmAnalysisResult("REVIEW", "Handle incidents", new java.util.HashMap<>(),
                        "Handle incidents", true, null));
        when(reportRepository.save(any(AiAdminHealthReport.class))).thenAnswer(i -> i.getArgument(0));

        AiAdminHealthReport report = service.generateReport(1L, AiAdminHealthReport.ReportType.DAILY);

        assertEquals(1, report.getIncidentsHandled());
        assertEquals(2, report.getActiveIncidents());
    }

    @Test
    void generateReport_throwsWhenAdminNotFound() {
        when(characterRepository.findById(999L)).thenReturn(Optional.empty());

        assertThrows(IllegalArgumentException.class, () ->
                service.generateReport(999L, AiAdminHealthReport.ReportType.DAILY));
    }

    @Test
    void generateReport_handlesLlmFailure() {
        when(characterRepository.findById(1L)).thenReturn(Optional.of(admin));
        when(orderRepository.findByAssignedAiAdminIdAndCreatedAtBetween(anyLong(), any(), any()))
                .thenReturn(new ArrayList<>());
        when(incidentRepository.findByAssignedAiAdminIdAndCreatedAtBetween(anyLong(), any(), any()))
                .thenReturn(new ArrayList<>());
        when(incidentRepository.countByAssignedAiAdminIdAndStatusIn(anyLong(), anyList()))
                .thenReturn(0L);
        when(llmService.analyzeReport(any(), any())).thenThrow(new RuntimeException("LLM down"));
        when(reportRepository.save(any(AiAdminHealthReport.class))).thenAnswer(i -> i.getArgument(0));

        AiAdminHealthReport report = service.generateReport(1L, AiAdminHealthReport.ReportType.DAILY);

        assertEquals("LLM unavailable. Manual review recommended.", report.getRecommendations());
    }

    @Test
    void generateReport_weeklyPeriod() {
        when(characterRepository.findById(1L)).thenReturn(Optional.of(admin));
        when(orderRepository.findByAssignedAiAdminIdAndCreatedAtBetween(anyLong(), any(), any()))
                .thenReturn(new ArrayList<>());
        when(incidentRepository.findByAssignedAiAdminIdAndCreatedAtBetween(anyLong(), any(), any()))
                .thenReturn(new ArrayList<>());
        when(incidentRepository.countByAssignedAiAdminIdAndStatusIn(anyLong(), anyList()))
                .thenReturn(0L);
        when(llmService.analyzeReport(any(), any())).thenReturn(
                new LlmAnalysisResult("REVIEW", "OK", new java.util.HashMap<>(), "OK", true, null));
        when(reportRepository.save(any(AiAdminHealthReport.class))).thenAnswer(i -> i.getArgument(0));

        AiAdminHealthReport report = service.generateReport(1L, AiAdminHealthReport.ReportType.WEEKLY);

        assertEquals(AiAdminHealthReport.ReportType.WEEKLY, report.getReportType());
        LocalDateTime periodStart = report.getPeriodStart();
        LocalDateTime periodEnd = report.getPeriodEnd();
        assertTrue(periodEnd.isAfter(periodStart));
    }

    @Test
    void generateAllReports_generatesForAllAdmins() {
        List<AiCharacter> admins = List.of(admin);
        when(characterRepository.findByAiAdminTrueAndActiveTrue()).thenReturn(admins);
        when(characterRepository.findById(1L)).thenReturn(Optional.of(admin));
        when(orderRepository.findByAssignedAiAdminIdAndCreatedAtBetween(anyLong(), any(), any()))
                .thenReturn(new ArrayList<>());
        when(incidentRepository.findByAssignedAiAdminIdAndCreatedAtBetween(anyLong(), any(), any()))
                .thenReturn(new ArrayList<>());
        when(incidentRepository.countByAssignedAiAdminIdAndStatusIn(anyLong(), anyList()))
                .thenReturn(0L);
        when(llmService.analyzeReport(any(), any())).thenReturn(
                new LlmAnalysisResult("REVIEW", "OK", new java.util.HashMap<>(), "OK", true, null));
        when(reportRepository.save(any(AiAdminHealthReport.class))).thenAnswer(i -> i.getArgument(0));

        List<AiAdminHealthReport> reports = service.generateAllReports(AiAdminHealthReport.ReportType.DAILY);

        assertEquals(1, reports.size());
    }

    @Test
    void generateAllReports_skipsFailedAdmin() {
        List<AiCharacter> admins = List.of(admin);
        when(characterRepository.findByAiAdminTrueAndActiveTrue()).thenReturn(admins);
        when(characterRepository.findById(1L)).thenReturn(Optional.of(admin));
        when(orderRepository.findByAssignedAiAdminIdAndCreatedAtBetween(anyLong(), any(), any()))
                .thenThrow(new RuntimeException("DB error"));

        List<AiAdminHealthReport> reports = service.generateAllReports(AiAdminHealthReport.ReportType.DAILY);

        assertEquals(0, reports.size());
    }

    @Test
    void getLatestReport_returnsReport() {
        AiAdminHealthReport report = new AiAdminHealthReport();
