    @Test
    void getReports_byDateRange() {
        when(reportRepository.findByAiAdminIdAndGeneratedAtBetweenOrderByGeneratedAtDesc(
                eq(1L), any(), any())).thenReturn(new ArrayList<>());

        List<AiAdminHealthReport> reports = service.getReports(
                1L, LocalDateTime.now().minusDays(7), LocalDateTime.now());

        assertNotNull(reports);
    }

    @Test
    void getReportSummary_withReports() {
        AiAdminHealthReport report = new AiAdminHealthReport();
        report.setReportType(AiAdminHealthReport.ReportType.DAILY);
        report.setGeneratedAt(LocalDateTime.now());
        report.setOrdersProcessed(10);
        report.setOrdersCompleted(8);
        report.setOrdersFailed(2);
        report.setIncidentsHandled(3);
        report.setXpEarned(80);
        when(reportRepository.findByAiAdminIdOrderByGeneratedAtDesc(1L))
                .thenReturn(List.of(report));
        when(reportRepository.countByAiAdminId(1L)).thenReturn(1L);

        AiAdminHealthReportService.ReportSummary summary = service.getReportSummary(1L);

        assertEquals(1L, summary.adminId);
        assertEquals(1, summary.totalReports);
        assertEquals(10, summary.totalOrdersProcessed);
        assertEquals(3, summary.totalIncidentsHandled);
        assertEquals(80, summary.totalXpEarned);
    }

    @Test
    void getReportSummary_empty() {
        when(reportRepository.findByAiAdminIdOrderByGeneratedAtDesc(1L))
                .thenReturn(new ArrayList<>());
        when(reportRepository.countByAiAdminId(1L)).thenReturn(0L);

        AiAdminHealthReportService.ReportSummary summary = service.getReportSummary(1L);

        assertEquals(1L, summary.adminId);
        assertEquals(0, summary.totalReports);
        assertEquals(0, summary.avgOrdersPerReport);
        assertEquals(0.0, summary.avgSuccessRate);
    }

