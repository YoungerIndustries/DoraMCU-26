    void generateDailyReports_runsWithoutError() {
        when(characterRepository.findByAiAdminTrueAndActiveTrue()).thenReturn(new ArrayList<>());

        service.generateDailyReports();

        // No exception thrown
    }

    @Test
    void generateDailyReports_handlesException() {
        when(characterRepository.findByAiAdminTrueAndActiveTrue())
                .thenThrow(new RuntimeException("DB down"));

        assertDoesNotThrow(() -> service.generateDailyReports());
