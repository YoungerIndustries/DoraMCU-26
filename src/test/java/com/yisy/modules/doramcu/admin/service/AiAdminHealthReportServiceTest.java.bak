    @Test
    void getReport_byType() {
        AiAdminHealthReport report = new AiAdminHealthReport();
        report.setReportType(AiAdminHealthReport.ReportType.WEEKLY);
        when(reportRepository.findByAiAdminIdAndReportTypeOrderByGeneratedAtDesc(1L, AiAdminHealthReport.ReportType.WEEKLY))
                .thenReturn(report);

        AiAdminHealthReport result = service.getReport(1L, AiAdminHealthReport.ReportType.WEEKLY);

        assertEquals(AiAdminHealthReport.ReportType.WEEKLY, result.getReportType());
