{
  "game_info": {
    "title": "OpenTTD Medieval & Low-Tech Vehicle Database for Fantasy Worlds",
    "description": "Pre-industrial vehicle database for low-tech fantasy worlds (D&D, medieval settings). Based on OpenTTD NewGRF mods: eGRVTS (horse-drawn vehicles) and Sailing Ships by J Mitchell. Replaces industrial vehicles with animal-drawn and wind-powered alternatives for worlds without steam or combustion technology.",
    "source_mods": [
      "eGRVTS - Extended Generic Road Vehicle and Tram Set by Zephyris (GPL v2) — horse-drawn vehicles from 1700s",
      "Sailing Ships by J Mitchell (GPL v2) — wind-powered ships from 1700-1920",
      "OpenTTD Core (GPL v2) — base game reference for vehicle stats"
    ],
    "integration_notes": "This file adds tech level 0 (Medieval/Pre-Industrial) vehicles. For D&D-style worlds, set planet tech_level to 0 to use only animal and creature mounts. These vehicles use PATH infrastructure instead of ROAD, and WHARF stations instead of PORT."
