[Unit]
Description=DoraMCU Game Server
Documentation=https://github.com/YoungerIndustries/DoraMCU-26
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/pi/doramcu
ExecStart=/usr/local/bin/docker compose --profile pi up -d
ExecStop=/usr/local/bin/docker compose --profile pi down
StandardOutput=journal
StandardError=journal
Environment=COMPOSE_PROJECT_NAME=doramcu
Environment=HOME=/home/pi

# Security hardening (relaxed for Docker Compose working directory)
ProtectSystem=full
ReadWritePaths=/home/pi/doramcu
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

# Resource limits for Pi
MemoryMax=3G
CPUQuota=800%

[Install]
WantedBy=multi-user.target
