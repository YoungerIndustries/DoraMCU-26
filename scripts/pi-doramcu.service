[Unit]
Description=DoraMCU Game Server
Documentation=https://github.com/YoungerIndustries/DoraMCU-26
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/pi/doramcu
ExecStart=/usr/local/bin/docker compose -f docker-compose.yml -f docker-compose.pi.yml up -d
ExecStop=/usr/local/bin/docker compose -f docker-compose.yml -f docker-compose.pi.yml down
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment=COMPOSE_PROJECT_NAME=doramcu
Environment=HOME=/home/pi

# Security hardening
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true

# Resource limits for Pi
MemoryMax=3G
CPUQuota=800%

[Install]
WantedBy=multi-user.target
