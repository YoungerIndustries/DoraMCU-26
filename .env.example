# DoraMCU Environment Variables
# Copy this file to .env and fill in the values before running docker-compose.

# Database password (MySQL root password)
DB_PASSWORD=CHANGE-ME-TO-A-SECURE-PASSWORD

# JWT secret for authentication (must be a long random string)
JWT_SECRET=CHANGE-ME-TO-A-LONG-RANDOM-STRING-AT-LEAST-256-BITS

# Deep Learning mode: "rest" (use Python DL service) or "local" (use DL4J in-process)
# Use "rest" in production to reduce Java memory footprint
DL_MODE=rest

# Debug mode: set to "true" to enable remote debugging on port 5005 (dev only)
DEBUG=

# Web client environment (dev, staging, prod)
WEB_ENV=prod

# Web client API URL (used to generate config.json for the web frontend)
# In production, set this to your public API URL
WEB_API_URL=http://app:8080

# LLM model for OpenHands AI coding agent
LLM_MODEL=ollama/qwen2.5:14b

# LLM API key (for OpenAI-compatible providers)
LLM_API_KEY=

# LLM base URL (for Ollama or custom endpoints)
LLM_BASE_URL=http://host.docker.internal:11434

# Neuron security JWT secret (separate from main JWT secret)
NEURON_SECURITY_JWT_SECRET=CHANGE-ME-TO-A-LONG-RANDOM-STRING

# Application version (overridden by build system in production)
APP_VERSION=0.3.9
