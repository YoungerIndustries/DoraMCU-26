# Multi-stage build for DoraMCU Neuron
#
# Usage:
#   Standard:  docker build -f Dockerfile.neuron -t doramcu/neuron:latest .
#   Edge:      docker build -f Dockerfile.neuron --build-arg BASE_IMAGE=eclipse-temurin:27-jre-alpine -t doramcu/neuron-edge:latest .
#   ARM64:     docker buildx build --platform linux/arm64/v8 -f Dockerfile.neuron --build-arg BASE_IMAGE=eclipse-temurin:27-jre-alpine -t doramcu/neuron-edge:latest .
#
# Build args:
#   BASE_IMAGE — Runtime base image (default: eclipse-temurin:27-jre)
#               Use eclipse-temurin:27-jre-alpine for edge-optimized builds

# ── Stage 1: Build ─────────────────────────────────────────────────────────────
FROM eclipse-temurin:27-jdk AS build
WORKDIR /app
COPY build.gradle settings.gradle gradlew ./
COPY gradle/wrapper gradle/wrapper
COPY src src
COPY dora-neuron dora-neuron
RUN chmod +x gradlew
RUN ./gradlew :dora-neuron:bootJar --no-daemon

# ── Stage 2: Runtime ───────────────────────────────────────────────────────────
ARG BASE_IMAGE=eclipse-temurin:27-jre
FROM ${BASE_IMAGE}
WORKDIR /app

# Run as non-root user (Alpine uses addgroup/adduser, Debian uses groupadd/useradd)
RUN if command -v addgroup > /dev/null 2>&1; then \
      addgroup -S neuron && adduser -S neuron -G neuron; \
    else \
      groupadd -r neuron && useradd -r -g neuron -d /app -s /sbin/nologin neuron; \
    fi

COPY --from=build /app/dora-neuron/build/libs/*.jar app.jar

# Create directories for models and temp files
RUN mkdir -p /app/dl-models /tmp/neuron-quantized-models && \
    chown -R neuron:neuron /app

USER neuron

EXPOSE 8090
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD wget -qO- http://localhost:8090/api/health/live || exit 1

ENV NEURON_COORDINATOR_URL=http://doramcu-app:8080
ENV NEURON_GAME_SERVER_URL=http://doramcu-app:8080

# Edge-optimized JVM settings when using Alpine base
# Standard: 1G heap, Edge: 512M heap
ENV JVM_ARGS="-Xmx1G -XX:+UseG1GC -XX:MaxGCPauseMillis=200"
ENV JAVA_OPTS="-Xms128m -Xmx512m -XX:+UseG1GC -XX:MaxGCPauseMillis=200 \
  -XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 \
  -Xss256k -Djava.security.egd=file:/dev/./urandom \
  -Dneuron.edge.auto-optimize=true"

# Allow overriding JVM memory at runtime: docker run -e JVM_XMX="-Xmx512m" ...
ENTRYPOINT ["sh", "-c", "java ${JVM_XMX:-$JVM_ARGS} -jar app.jar"]
