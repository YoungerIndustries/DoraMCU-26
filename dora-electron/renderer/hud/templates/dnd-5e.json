{
    "id": "dnd-5e",
    "name": "D&D 5th Edition",
    "icon": "🐉",
    "gameModule": "dnd-5e",

    "layout": {
        "leftPanelWidth": 300,
        "rightPanelWidth": 320,
        "leftSplitRatio": 0.4,
        "rightSplitRatio": 0.5
    },

    "theme": {
        "cssVariables": {
            "--hud-accent-primary": "#b45309",
            "--hud-accent-secondary": "#92400e",
            "--hud-accent-glow": "rgba(180, 83, 9, 0.15)"
        },
        "fontFamily": "'Segoe UI', system-ui, -apple-system, sans-serif",
        "panelBackground": "#1c1917",
        "accentColor": "#b45309",
        "borderColor": "#44403c",
        "fontColor": "#e7e5e4"
    },

    "panels": {
        "info": {
            "visible": true,
            "title": "Character Sheet",
            "components": [
                {
                    "type": "selector",
                    "label": "Select Character...",
                    "dataBinding": "character-select"
                },
                {
                    "type": "selector",
                    "label": "Select Campaign...",
                    "dataBinding": "campaign-select"
                },
                {
                    "type": "stat-bar",
                    "label": "HP",
                    "dataBinding": "hit-points"
                },
                {
                    "type": "stat-bar",
                    "label": "Temp HP",
                    "dataBinding": "temp-hit-points"
                },
                {
                    "type": "stat-bar",
                    "label": "Spell Slots",
                    "dataBinding": "spell-slots"
                }
            ]
        },
        "prompt": {
            "visible": true,
            "title": "DM Narrative",
            "components": [
                {
                    "type": "narrative-text",
                    "label": "Select a campaign to begin...",
                    "dataBinding": "campaign-narrative"
                }
            ]
        },
        "responses": {
            "visible": true,
            "title": "Actions",
            "components": [
                {
                    "type": "action-button",
                    "icon": "⚔️",
                    "label": "Attack",
                    "hint": "Make an attack roll",
                    "dataBinding": "action-attack"
                },
                {
                    "type": "action-button",
                    "icon": "✨",
                    "label": "Cast Spell",
                    "hint": "Cast a spell",
                    "dataBinding": "action-cast-spell"
                },
                {
                    "type": "action-button",
                    "icon": "🎲",
                    "label": "Roll d20",
                    "hint": "Simple d20 roll",
                    "dataBinding": "action-roll-d20"
                },
                {
                    "type": "action-button",
                    "icon": "🎲+",
                    "label": "Roll Advantage",
                    "hint": "Roll 2d20, take higher",
                    "dataBinding": "action-roll-advantage"
                },
                {
                    "type": "action-button",
                    "icon": "🎲-",
                    "label": "Roll Disadvantage",
                    "hint": "Roll 2d20, take lower",
                    "dataBinding": "action-roll-disadvantage"
                },
                {
                    "type": "action-button",
                    "icon": "💚",
                    "label": "Heal",
                    "hint": "Heal a combatant",
                    "dataBinding": "action-heal"
                },
                {
                    "type": "action-button",
                    "icon": "🏃",
                    "label": "Dash",
                    "hint": "Double movement",
                    "dataBinding": "action-dash"
                },
                {
                    "type": "action-button",
                    "icon": "🛡️",
                    "label": "Dodge",
                    "hint": "Defensive maneuver",
                    "dataBinding": "action-dodge"
                },
                {
                    "type": "action-button",
                    "icon": "🤝",
                    "label": "Help",
                    "hint": "Assist an ally",
                    "dataBinding": "action-help"
                },
                {
                    "type": "action-button",
                    "icon": "📋",
                    "label": "Skill Check",
                    "hint": "Make a skill check",
                    "dataBinding": "action-skill-check"
                },
                {
                    "type": "action-button",
                    "icon": "💀",
                    "label": "Saving Throw",
                    "hint": "Make a saving throw",
                    "dataBinding": "action-saving-throw"
                },
                {
                    "type": "action-button",
                    "icon": "⏭️",
                    "label": "End Round",
                    "hint": "Advance to next round",
                    "dataBinding": "action-end-round"
                }
            ]
        },
        "actions": {
            "visible": true,
            "title": "Combat Log",
            "components": [
                {
                    "type": "dice-roller",
                    "dataBinding": "dice-results"
                },
                {
                    "type": "event-log",
                    "dataBinding": "combat-log"
                },
                {
                    "type": "chat-input",
                    "label": "Type a message...",
                    "dataBinding": "chat-input"
                }
            ]
        }
    },

    "view3D": {
        "renderer": "threejs",
        "cameraMode": "third-person",
        "showCrosshair": false,
        "showMinimap": true
    }
}
