{
    "id": "earth-2026",
    "name": "Earth 2026",
    "icon": "🌍",
    "gameModule": "earth2026",

    "layout": {
        "leftPanelWidth": 280,
        "rightPanelWidth": 300,
        "leftSplitRatio": 0.4,
        "rightSplitRatio": 0.5
    },

    "theme": {
        "cssVariables": {
            "--hud-accent-primary": "#10b981",
            "--hud-accent-secondary": "#059669",
            "--hud-accent-glow": "rgba(16, 185, 129, 0.15)"
        },
        "fontFamily": "'Segoe UI', system-ui, -apple-system, sans-serif",
        "panelBackground": "#1a2332",
        "accentColor": "#10b981",
        "borderColor": "#2a3a52",
        "fontColor": "#e2e8f0"
    },

    "panels": {
        "info": {
            "visible": true,
            "title": "Character Status",
            "components": [
                {
                    "type": "selector",
                    "label": "Select Character...",
                    "dataBinding": "character-select"
                }
            ]
        },
        "prompt": {
            "visible": true,
            "title": "Scenario & Events",
            "components": [
                {
                    "type": "narrative-text",
                    "label": "Select a scenario to begin...",
                    "dataBinding": "scenario-narrative"
                }
            ]
        },
        "responses": {
            "visible": true,
            "title": "Actions",
            "components": [
                {
                    "type": "action-button",
                    "icon": "🔍",
                    "label": "Scavenge",
                    "hint": "Search for supplies",
                    "dataBinding": "scavenge"
                },
                {
                    "type": "action-button",
                    "icon": "🏕️",
                    "label": "Rest",
                    "hint": "Recover hunger & fatigue",
                    "dataBinding": "rest"
                },
                {
                    "type": "action-button",
                    "icon": "🗺️",
                    "label": "Travel",
                    "hint": "Move to another location",
                    "dataBinding": "travel"
                },
                {
                    "type": "action-button",
                    "icon": "👥",
                    "label": "Join Party",
                    "hint": "Team up with others",
                    "dataBinding": "join-party"
                },
                {
                    "type": "action-button",
                    "icon": "🏢",
                    "label": "Join Organization",
                    "hint": "Align with a faction",
                    "dataBinding": "join-organization"
                },
                {
                    "type": "action-button",
                    "icon": "🤝",
                    "label": "Recruit Companion",
                    "hint": "Add an ally",
                    "dataBinding": "recruit-companion"
                },
                {
                    "type": "action-button",
                    "icon": "🏠",
                    "label": "View Properties",
                    "hint": "Browse real estate",
                    "dataBinding": "view-properties"
                }
            ]
        },
        "actions": {
            "visible": true,
            "title": "Event Log",
            "components": [
                {
                    "type": "event-log",
                    "dataBinding": "event-log"
                },
                {
                    "type": "chat-input",
                    "placeholder": "Party chat message...",
                    "dataBinding": "party-chat"
                }
            ]
        }
    },

    "view3D": {
        "renderer": "threejs",
        "cameraMode": "third-person",
        "showCrosshair": false,
        "showMinimap": true
    }
}
