{
    "id": "captains-log",
    "name": "Captain's Log",
    "icon": "🖖",
    "gameModule": "captains-log",

    "layout": {
        "leftPanelWidth": 300,
        "rightPanelWidth": 300,
        "leftSplitRatio": 0.4,
        "rightSplitRatio": 0.5
    },

    "theme": {
        "cssVariables": {
            "--hud-accent-primary": "#0d9488",
            "--hud-accent-secondary": "#0f766e",
            "--hud-accent-glow": "rgba(13, 148, 136, 0.15)"
        },
        "fontFamily": "'Segoe UI', system-ui, -apple-system, sans-serif",
        "panelBackground": "#0f172a",
        "accentColor": "#0d9488",
        "borderColor": "#1e3a5f",
        "fontColor": "#e2e8f0"
    },

    "panels": {
        "info": {
            "visible": true,
            "title": "Character & Mission",
            "components": [
                {
                    "type": "selector",
                    "label": "Select Character...",
                    "dataBinding": "character-select"
                },
                {
                    "type": "selector",
                    "label": "Select Mission...",
                    "dataBinding": "mission-select"
                }
            ]
        },
        "prompt": {
            "visible": true,
            "title": "Mission Narrative",
            "components": [
                {
                    "type": "narrative-text",
                    "label": "Select a mission to begin...",
                    "dataBinding": "mission-narrative"
                }
            ]
        },
        "responses": {
            "visible": true,
            "title": "Task Attempts",
            "components": [
                {
                    "type": "action-button",
                    "icon": "✈️",
                    "label": "Pilot",
                    "hint": "Fitness + Pilot",
                    "dataBinding": "task-pilot"
                },
                {
                    "type": "action-button",
                    "icon": "🧭",
                    "label": "Navigate",
                    "hint": "Reason + Navigate",
                    "dataBinding": "task-navigate"
                },
                {
                    "type": "action-button",
                    "icon": "🔬",
                    "label": "Science",
                    "hint": "Reason + Science",
                    "dataBinding": "task-science"
                },
                {
                    "type": "action-button",
                    "icon": "🔫",
                    "label": "Security",
                    "hint": "Strength + Security",
                    "dataBinding": "task-security"
                },
                {
                    "type": "action-button",
                    "icon": "🏥",
                    "label": "Medical",
                    "hint": "Insight + Medical",
                    "dataBinding": "task-medical"
                },
                {
                    "type": "action-button",
                    "icon": "⚙️",
                    "label": "Engineering",
                    "hint": "Technical + Engineering",
                    "dataBinding": "task-engineering"
                },
                {
                    "type": "action-button",
                    "icon": "🤝",
                    "label": "Diplomacy",
                    "hint": "Presence + Diplomacy",
                    "dataBinding": "task-diplomacy"
                },
                {
                    "type": "action-button",
                    "icon": "👑",
                    "label": "Command",
                    "hint": "Presence + Command",
                    "dataBinding": "task-command"
                },
                {
                    "type": "action-button",
                    "icon": "📢",
                    "label": "Leadership",
                    "hint": "Presence + Leadership",
                    "dataBinding": "task-leadership"
                },
                {
                    "type": "action-button",
                    "icon": "🎲",
                    "label": "Oracle Query",
                    "hint": "Ask yes/no question",
                    "dataBinding": "oracle-query"
                },
                {
                    "type": "action-button",
                    "icon": "📝",
                    "label": "Log Entry",
                    "hint": "Write mission log",
                    "dataBinding": "log-entry"
                },
                {
                    "type": "action-button",
                    "icon": "⏭️",
                    "label": "Advance Beat",
                    "hint": "Move to next beat",
                    "dataBinding": "advance-beat"
                }
            ]
        },
        "actions": {
            "visible": true,
            "title": "Dice & Events",
            "components": [
                {
                    "type": "dice-roller",
                    "dataBinding": "dice-results"
                },
                {
                    "type": "event-log",
                    "dataBinding": "event-log"
                }
            ]
        }
    },

    "view3D": {
        "renderer": "threejs",
        "cameraMode": "third-person",
        "showCrosshair": false,
        "showMinimap": false
    }
}
