{
    "id": "babylon5",
    "name": "Babylon 5 Universe",
    "icon": "🛸",
    "gameModule": "babylon5",

    "layout": {
        "leftPanelWidth": 300,
        "rightPanelWidth": 320,
        "leftSplitRatio": 0.4,
        "rightSplitRatio": 0.5
    },

    "theme": {
        "cssVariables": {
            "--hud-accent-primary": "#3b82f6",
            "--hud-accent-secondary": "#1d4ed8",
            "--hud-accent-glow": "rgba(59, 130, 246, 0.15)"
        },
        "fontFamily": "'Segoe UI', system-ui, -apple-system, sans-serif",
        "panelBackground": "#0f172a",
        "accentColor": "#3b82f6",
        "borderColor": "#1e3a5f",
        "fontColor": "#e2e8f0"
    },

    "panels": {
        "info": {
            "visible": true,
            "title": "Character Profile",
            "components": [
                {
                    "type": "selector",
                    "label": "Select Character...",
                    "dataBinding": "character-select"
                },
                {
                    "type": "selector",
                    "label": "Filter by Species...",
                    "dataBinding": "species-filter"
                },
                {
                    "type": "stat-bar",
                    "label": "Characteristics",
                    "dataBinding": "characteristics"
                }
            ]
        },
        "prompt": {
            "visible": true,
            "title": "Story & Dialogue",
            "components": [
                {
                    "type": "narrative-text",
                    "label": "Select a storyline or character to explore...",
                    "dataBinding": "storyline-narrative"
                }
            ]
        },
        "responses": {
            "visible": true,
            "title": "Explore Universe",
            "components": [
                {
                    "type": "action-button",
                    "icon": "👤",
                    "label": "Browse Characters",
                    "hint": "View all B5 characters",
                    "dataBinding": "action-browse-characters"
                },
                {
                    "type": "action-button",
                    "icon": "📖",
                    "label": "Browse Storylines",
                    "hint": "View story arcs and chapters",
                    "dataBinding": "action-browse-storylines"
                },
                {
                    "type": "action-button",
                    "icon": "💬",
                    "label": "Browse Dialogues",
                    "hint": "View famous dialogue scenes",
                    "dataBinding": "action-browse-dialogues"
                },
                {
                    "type": "action-button",
                    "icon": "🌍",
                    "label": "Browse Locations",
                    "hint": "View stations, planets, and sectors",
                    "dataBinding": "action-browse-locations"
                },
                {
                    "type": "action-button",
                    "icon": "👽",
                    "label": "Browse Races",
                    "hint": "View alien races and traits",
                    "dataBinding": "action-browse-races"
                },
                {
                    "type": "action-button",
                    "icon": "🌌",
                    "label": "Generate Galaxy",
                    "hint": "Create a B5-themed 4X galaxy",
                    "dataBinding": "action-generate-galaxy"
                },
                {
                    "type": "action-button",
                    "icon": "📋",
                    "label": "View Story Arc",
                    "hint": "Read selected character's story arc",
                    "dataBinding": "action-view-story-arc"
                },
                {
                    "type": "action-button",
                    "icon": "🗣️",
                    "label": "View Quotes",
                    "hint": "Read selected character's famous quotes",
                    "dataBinding": "action-view-quotes"
                },
                {
                    "type": "action-button",
                    "icon": "🔗",
                    "label": "View Relationships",
                    "hint": "See character relationships",
                    "dataBinding": "action-view-relationships"
                },
                {
                    "type": "action-button",
                    "icon": "📊",
                    "label": "View Personality",
                    "hint": "Read character personality profile",
                    "dataBinding": "action-view-personality"
                }
            ]
        },
        "actions": {
            "visible": true,
            "title": "Event Log",
            "components": [
                {
                    "type": "event-log",
                    "dataBinding": "event-log"
                },
                {
                    "type": "chat-input",
                    "label": "Search characters or storylines...",
                    "dataBinding": "chat-input"
                }
            ]
        }
    },

    "view3D": {
        "renderer": "threejs",
        "cameraMode": "third-person",
        "showCrosshair": false,
        "showMinimap": false
    }
}
