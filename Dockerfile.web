# DoraMCU Web — Nginx static file server
#
# Usage:
#   Dev:       docker build -f Dockerfile.web -t doramcu/web:latest .
#   Prod:      docker build -f Dockerfile.web --target prod -t doramcu/web:prod .
#   Custom:    docker build -f Dockerfile.web --build-arg WEB_ENV=prod --build-arg WEB_API_URL=http://app:8080 -t doramcu/web:latest .
#
# Build args:
#   WEB_ENV     — Environment (dev/prod, default: prod)
#   WEB_API_URL — Backend API URL for config generation

# ── Stage 1: Generate web client config ────────────────────────────────────────
FROM eclipse-temurin:27-jdk AS config-gen
WORKDIR /app
COPY build.gradle settings.gradle gradlew ./
COPY gradle/wrapper gradle/wrapper
COPY dora-web dora-web
ARG WEB_ENV=prod
ARG WEB_API_URL=
RUN chmod +x gradlew && \
    if [ -n "$WEB_API_URL" ]; then \
        ./gradlew generateWebConfig --no-daemon -Dweb.env=$WEB_ENV -Dweb.api.url=$WEB_API_URL; \
    else \
        ./gradlew generateWebConfig --no-daemon -Dweb.env=$WEB_ENV; \
    fi

# ── Stage 2: Nginx serves the static web client (dev target) ──────────────────
FROM nginx:alpine AS runtime
COPY --from=config-gen /app/dora-web /usr/share/nginx/html
COPY dora-web/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:80/ || exit 1

# ── Production target (pre-built static files, no config generation) ──────────
FROM nginx:alpine AS prod
COPY dora-web /usr/share/nginx/html
COPY dora-web/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:80/nginx-health || exit 1
