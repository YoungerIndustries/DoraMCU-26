{
  "manifest_version": 3,
  "name": "DoraMCU Game Node Extension",
  "version": "0.3.9",
  "description": "Enhances the DoraMCU PWA with local AI inference and offline storage capabilities",
  "permissions": [
    "storage",
    "background"
  ],
  "host_permissions": [
    "https://*/*",
    "ws://*/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
