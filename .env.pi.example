# =============================================================================
# DoraMCU Raspberry Pi Environment Configuration
# =============================================================================
# Copy this file to .env and modify the values for your Pi deployment.
#
# Usage: cp .env.pi.example .env
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
# MySQL root password — CHANGE THIS!
DB_PASSWORD=change_me_pi_secure_password

# ── Security ──────────────────────────────────────────────────────────────────
# JWT signing key — generate with: openssl rand -hex 32
JWT_SECRET=change_me_generate_with_openssl_rand_hex_32

# Neuron JWT secret — generate with: openssl rand -hex 32
NEURON_SECURITY_JWT_SECRET=change_me_generate_with_openssl_rand_hex_32

# ── JVM Memory ────────────────────────────────────────────────────────────────
# Pi 4 (2GB RAM):  -Xmx256m
# Pi 4 (4GB RAM):  -Xmx512m
# Pi 4 (8GB RAM):  -Xmx1G
# Pi 5 (8GB RAM):  -Xmx1G
JVM_XMX=-Xmx512m

# ── Deep Learning Mode ───────────────────────────────────────────────────────
# "rest" — Use Python DL microservice (recommended for Pi)
# "local" — Use DL4J in-process (requires more memory)
DL_MODE=rest

# ── Debug Mode ────────────────────────────────────────────────────────────────
# Set to "true" to enable remote debugging on port 5005
DEBUG=

# ── Web Client ────────────────────────────────────────────────────────────────
# Web environment (dev/prod)
WEB_ENV=prod

# Backend API URL for web client config
WEB_API_URL=http://app:8080

# ── OpenHands (Debug profile only) ───────────────────────────────────────────
# LLM model for OpenHands AI assistant
LLM_MODEL=ollama/qwen2.5:14b

# LLM API key
LLM_API_KEY=ollama

# LLM base URL (Ollama on host machine)
LLM_BASE_URL=http://host.docker.internal:11434
