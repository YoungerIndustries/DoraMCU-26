# Production Dockerfile for Neuron - uses pre-built JAR
FROM eclipse-temurin:27-jdk
WORKDIR /app

COPY dora-neuron/build/libs/dora-neuron-0.4.0.jar app.jar

RUN groupadd -r neuron && useradd -r -g neuron -d /app -s /sbin/nologin neuron && chown -R neuron:neuron /app
USER neuron

EXPOSE 8090
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD wget -qO- http://localhost:8090/api/health/live || exit 1

ENV NEURON_COORDINATOR_URL=http://doramcu-app:8080
ENV NEURON_GAME_SERVER_URL=http://doramcu-app:8080

ENTRYPOINT ["java", "-Xmx1G", "-XX:+UseG1GC", "-XX:MaxGCPauseMillis=200", "-jar", "app.jar"]
