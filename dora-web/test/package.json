{
  "name": "dora-web-tests",
  "version": "1.0.0",
  "description": "Tests for DoraMCU unified web client modules",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": [
      "**/test/**/*.test.js"
    ],
    "moduleFileExtensions": ["js"],
    "setupFilesAfterEnv": ["<rootDir>/jest.setup.js"],
    "collectCoverageFrom": [
      "js/**/*.js",
      "!js/vendor/**"
    ]
  }
}
