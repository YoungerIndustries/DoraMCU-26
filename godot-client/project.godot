}

pause={
 "events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_parent":null,"device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":417,"key_label":0,"unicode":0,"physical_unicode":0,"echo":false,"script":null)
