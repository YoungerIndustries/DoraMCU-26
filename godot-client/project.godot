; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious and
; must be validated on a key-by-key basis.
;
; Format:
;   [section] (starts section "section")
;   key=value (sets property "key" to "value" in current section)
;
; Uncomment the lines to add them to your project.

config_version=5

[application]

config/name="DoraMCU"
config/description="3D Space Strategy Game - Ported from Unity to Godot"
config/version="1.0.0"
config/main_scene="res://Scenes/MainScene.tscn"
config/icon="res://icon/icon.svg"

[autoload]

ServerConfig="res://Scripts/Core/ServerConfig.cs"
NetworkManager="res://Scripts/Network/NetworkManager.cs"
GameManager="res://Scripts/Core/GameManager.cs"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[editor]

features_enabled/preset="2D, 3D, Audio, C#, Debug, GDB, GLSL, GridMap, Multi-Mesh, Navigation, Particles, Physics, Physics 2D, Physics 2D Godot Physics, Physics Godot Physics, RID, VisualShader, VisualServer, VisualServer Scene, VisualServer Server"

[editor_layout]

ui/scripts_panel/show_script_filters=true

[input]

ship_build={
 "events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_parent":null,"device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":86,"key_label":0,"unicode":118,"physical_unicode":118,"echo":false,"script":null)
 ],
 "deadzone": 0.5
}

scan_sector={
 "events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_parent":null,"device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":88,"key_label":0,"unicode":120,"physical_unicode":120,"echo":false,"script":null)
 ],
 "deadzone": 0.5
}

toggle_map={
 "events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_parent":null,"device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":418,"key_label":0,"unicode":0,"physical_unicode":0,"echo":false,"script":null)
 ],
 "deadzone": 0.5
}

toggle_inventory={
 "events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_parent":null,"device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":73,"key_label":0,"unicode":105,"physical_unicode":105,"echo":false,"script":null)
 ],
 "deadzone": 0.5
}

help={
 "events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_parent":null,"device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":66976611,"key_label":0,"unicode":0,"physical_unicode":0,"echo":false,"script":null)
 ],
